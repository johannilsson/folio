<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Folio.Core</RootNamespace>
    <!-- The answers to the app link are written into memory the C runtime frees (Engine.AppListen). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- CommonMark and GFM (tables, task lists, strikethrough) with the source position of every node. -->
    <PackageReference Include="Markdig" Version="0.42.0" />
  </ItemGroup>

  <!-- The engine, built as a cdylib into target/cdylib by windows/verify.sh (see the cargo rustc line there).
       Copied next to whatever references this project: folio.dll on Windows, libfolio.so on Linux. -->
  <PropertyGroup>
    <FolioNativeDir Condition="'$(FolioNativeDir)' == ''">$(MSBuildThisFileDirectory)../../target/cdylib/release</FolioNativeDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(FolioNativeDir)/folio.dll" Condition="Exists('$(FolioNativeDir)/folio.dll')" Link="folio.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(FolioNativeDir)/libfolio.so" Condition="Exists('$(FolioNativeDir)/libfolio.so')" Link="libfolio.so" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
