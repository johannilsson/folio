{
  "$description": "Folio's own colours, in the W3C design tokens format. scripts/tokens.mjs generates macos/Sources/FolioKit/Tokens.swift and frontend/src/tokens.ts from this file; edit it here and run the script. A token with light and dark children follows the system's appearance.",
  "color": {
    "background": {
      "$description": "Behind the text, and behind the diagrams drawn into it.",
      "light": { "$type": "color", "$value": "#ffffff" },
      "dark": { "$type": "color", "$value": "#1a1a1a" }
    },
    "card": {
      "$description": "An annotation card, and the column of cards beside the text.",
      "light": { "$type": "color", "$value": "#f6f6f5" },
      "dark": { "$type": "color", "$value": "#252525" }
    },
    "float": {
      "$description": "Pieces floating over the text: the open card, the Comment button, the toast.",
      "light": { "$type": "color", "$value": "#ffffff" },
      "dark": { "$type": "color", "$value": "#2e2e2e" }
    },
    "avatar": {
      "$description": "Who wrote an annotation: You, then the others by a hash of their name.",
      "you": { "$type": "color", "$value": "#6366f1" },
      "cyan": { "$type": "color", "$value": "#0891b2" },
      "pink": { "$type": "color", "$value": "#db2777" },
      "violet": { "$type": "color", "$value": "#7c3aed" }
    },
    "diagram": {
      "$description": "Mermaid diagrams, in Folio's purple.",
      "node": {
        "light": { "$type": "color", "$value": "#f1ecfc" },
        "dark": { "$type": "color", "$value": "#2b2640" }
      },
      "border": {
        "light": { "$type": "color", "$value": "#a78bfa" },
        "dark": { "$type": "color", "$value": "#8b7bd8" }
      },
      "text": {
        "light": { "$type": "color", "$value": "#1a1a1a" },
        "dark": { "$type": "color", "$value": "#e0e0e0" }
      },
      "line": {
        "light": { "$type": "color", "$value": "#8b6fd8" },
        "dark": { "$type": "color", "$value": "#8b7bd8" }
      },
      "accent": {
        "light": { "$type": "color", "$value": "#7c3aed" },
        "dark": { "$type": "color", "$value": "#a78bfa" }
      },
      "cluster": {
        "light": { "$type": "color", "$value": "#f7f4fd" },
        "dark": { "$type": "color", "$value": "#211e30" }
      }
    }
  },
  "system": {
    "$description": "Chrome follows the system: the app uses these system colours by name, never these values. They are samples for design tools, and nothing is generated from them.",
    "accent": { "$type": "color", "$value": "#007aff", "$description": "NSColor.controlAccentColor: the user's accent colour (focus, selection in the sidebar)." },
    "annotation": { "$type": "color", "$value": "#af52de", "$description": "NSColor.systemPurple: annotated text." },
    "deletion": { "$type": "color", "$value": "#ff3b30", "$description": "NSColor.systemRed: deleted and replaced text." },
    "label": { "$type": "color", "$value": "#000000d9", "$description": "NSColor.labelColor." },
    "separator": { "$type": "color", "$value": "#0000001a", "$description": "NSColor.separatorColor: card edges, hairlines." }
  }
}
